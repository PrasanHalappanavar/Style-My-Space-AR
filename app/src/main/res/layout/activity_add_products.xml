<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/imageupload"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:scaleType="centerCrop"
                android:background="#EEEEEE"
                android:contentDescription="Uploaded image" />

            <Button
                android:id="@+id/btnchooseImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Choose Image"
                android:layout_marginTop="10dp" />

            <Button
                android:id="@+id/btnchooseModel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Choose 3D Model (.glb or .sfb)"
                android:layout_marginTop="10dp" />

            <TextView
                android:id="@+id/txtModelName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No model selected"
                android:textColor="#444444"
                android:layout_marginTop="6dp" />

            <EditText
                android:id="@+id/name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Product Name"
                android:layout_marginTop="12dp"
                android:background="@android:drawable/edit_text"
                android:padding="10dp" />

            <EditText
                android:id="@+id/price"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Price"
                android:inputType="number"
                android:layout_marginTop="8dp"
                android:background="@android:drawable/edit_text"
                android:padding="10dp" />

            <EditText
                android:id="@+id/type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Type"
                android:layout_marginTop="8dp"
                android:background="@android:drawable/edit_text"
                android:padding="10dp" />

            <EditText
                android:id="@+id/details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Details"
                android:layout_marginTop="8dp"
                android:background="@android:drawable/edit_text"
                android:padding="10dp"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:maxLines="6"
                android:scrollbars="vertical" />

            <EditText
                android:id="@+id/count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Count (stock quantity)"
                android:inputType="number"
                android:layout_marginTop="8dp"
                android:background="@android:drawable/edit_text"
                android:padding="10dp" />


            <Button
                android:id="@+id/btnAdd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Add Product"
                android:layout_marginTop="16dp"
                android:background="#FF6200EE"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:itemIconTint="@drawable/nav_item_selector"
        app:itemTextColor="@drawable/nav_item_selector"
        app:menu="@menu/admin_nav_menu"
        app:labelVisibilityMode="labeled"
        app:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
