<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".MainActivity">

    <!-- AR Fragment Full Screen -->
    <fragment
        android:id="@+id/fragment"
        android:name="com.google.ar.sceneform.ux.ArFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Top Control Panel -->
    <LinearLayout
        android:id="@+id/topControlPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/control_panel_background"
        android:padding="8dp"
        android:layout_margin="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Button Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_horizontal">

            <Button
                android:id="@+id/btnRemoveAll"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/button_remove_background"
                android:text="Clear"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp" />

            <Button
                android:id="@+id/btnScreenshot"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/button_capture_background"
                android:text="Capture"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp" />

            <Button
                android:id="@+id/btnResetModel"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/button_reset_background"
                android:text="Reset"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp" />

            <Button
                android:id="@+id/btnToggleInfo"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/button_info_background"
                android:text="Hide Info"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp" />

            <ImageButton
                android:id="@+id/btnUndo"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_menu_revert"
                android:contentDescription="Undo" />

            <ImageButton
                android:id="@+id/btnRedo"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_menu_rotate"
                android:contentDescription="Redo" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/btnReloadModels"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_menu_rotate"
            android:contentDescription="Reload Models"
            app:layout_constraintTop_toTopOf="@id/topControlPanel"
            app:layout_constraintBottom_toBottomOf="@id/topControlPanel"
            app:layout_constraintEnd_toEndOf="parent"
            android:padding="8dp"/>

        <!-- Model Information Display -->
        <TextView
            android:id="@+id/modelInfoText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Model: None Selected\\nObjects: 0"
            android:textColor="@color/black"
            android:textSize="12sp"
            android:background="@drawable/info_text_background"
            android:padding="6dp"
            android:gravity="center" />

        <!-- Dimensions Display -->
        <TextView
            android:id="@+id/dimensionsDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Dimensions: L: 0.00m  W: 0.00m  H: 0.00m"
            android:textColor="@color/black"
            android:textSize="12sp"
            android:background="@drawable/dimensions_background"
            android:padding="6dp"
            android:gravity="center"
            android:drawablePadding="4dp" />

    </LinearLayout>

    <!-- Side Control Panel -->
    <LinearLayout
        android:id="@+id/sideControlPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/side_panel_background"
        android:padding="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toBottomOf="@id/topControlPanel"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Lighting Control -->
        <TextView
            android:id="@+id/lightingControl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💡"
            android:textSize="24sp"
            android:padding="8dp"
            android:background="@drawable/circular_button_background"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />

        <!-- Distance Info -->
        <TextView
            android:id="@+id/distanceInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="📏"
            android:textSize="20sp"
            android:padding="6dp"
            android:background="@drawable/circular_button_background"
            android:gravity="center" />

    </LinearLayout>

